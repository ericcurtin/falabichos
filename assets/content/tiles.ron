// Tile legend: the character used in map rows -> art + behaviour.
// kind: Floor (default) | Solid | TallGrass | Water | Counter
[
    // ---- outdoors
    (ch: '.', name: "grass",       art: ["grass"]),
    (ch: '"', name: "tall_grass",  art: ["tall_grass"], kind: TallGrass),
    (ch: ',', name: "flowers",     art: ["flowers"]),
    (ch: ':', name: "path",        art: ["path"]),
    (ch: '_', name: "calcada",     art: ["calcada"]),
    (ch: '~', name: "water",       art: ["water"], kind: Water),
    (ch: 's', name: "sand",        art: ["sand"]),
    (ch: 'k', name: "pier",        art: ["pier"]),
    (ch: 'q', name: "tram_track",  art: ["tram_track"]),
    (ch: '=', name: "stairs",      art: ["stairs"]),
    (ch: 'T', name: "tree",        art: ["tree"], kind: Solid),
    (ch: 'h', name: "hedge",       art: ["hedge"], kind: Solid),
    (ch: 'O', name: "rock",        art: ["rock"], kind: Solid),
    (ch: '#', name: "wall_white",  art: ["wall_white"], kind: Solid),
    (ch: 'w', name: "wall_window", art: ["wall_window"], kind: Solid),
    (ch: 'y', name: "wall_yellow", art: ["wall_yellow"], kind: Solid),
    (ch: 'p', name: "wall_pink",   art: ["wall_pink"], kind: Solid),
    (ch: 'Z', name: "azulejo",     art: ["azulejo"], kind: Solid),
    (ch: 'R', name: "roof",        art: ["roof"], kind: Solid),
    (ch: 'r', name: "roof_edge",   art: ["roof_edge"], kind: Solid),
    (ch: 'D', name: "door",        art: ["door"]),
    (ch: 'S', name: "sign",        art: ["sign"], kind: Solid),
    (ch: 'f', name: "fence",       art: ["fence"], kind: Solid),
    (ch: 'B', name: "boat",        art: ["boat"], kind: Solid),
    (ch: 'L', name: "lamp",        art: ["lamp"], kind: Solid),
    (ch: 'b', name: "bench",       art: ["bench"], kind: Solid),
    (ch: 'j', name: "bridge",      art: ["bridge"]),
    (ch: 'Q', name: "quay_wall",   art: ["quay_wall"], kind: Solid),
    (ch: 'V', name: "vines",       art: ["vines"], kind: Solid),
    // ---- indoors
    (ch: 'F', name: "floor_wood",     art: ["floor_wood"]),
    (ch: 'K', name: "floor_tile",     art: ["floor_tile"]),
    (ch: 'C', name: "rug",            art: ["rug"]),
    (ch: 'E', name: "exit_mat",       art: ["exit_mat"]),
    (ch: 'N', name: "indoor_wall",    art: ["indoor_wall"], kind: Solid),
    (ch: 'X', name: "counter",        art: ["counter"], kind: Counter),
    (ch: 'U', name: "coffee_machine", art: ["coffee_machine"], kind: Counter),
    (ch: 'A', name: "pastry_case",    art: ["pastry_case"], kind: Counter),
    (ch: 'H', name: "shelf",          art: ["shelf"], kind: Solid),
    (ch: 'G', name: "bookshelf",      art: ["bookshelf"], kind: Solid),
    (ch: 'M', name: "table",          art: ["table"], kind: Solid),
    (ch: 'J', name: "bed",            art: ["bed"], kind: Solid),
    (ch: 'P', name: "plant",          art: ["plant"], kind: Solid),
    (ch: 'I', name: "stove",          art: ["stove"], kind: Solid),
    (ch: 'u', name: "barrel",         art: ["barrel"], kind: Solid),
]
