        kind: Noun, gender: Fem,
        ipa: "ɨʃˈkeɾdɐ", pron_tags: [ReducedVowel, SibilantS],
        example: (pt: "Vira à esquerda na ponte.", en: "Turn left at the bridge."),
        note: "Used as 'à esquerda' (a + a esquerda). 'À esquerda de' means 'to the left of'.",
        forms: ["à esquerda"],
        needs_native_review: true,
    ),
