// Greetings and politeness (Gaivota)
// One entry per word or phrase. Field reference: docs/CONTENT_FORMAT.md
[
    (
        id: "ola", pt: "olá", en: ["hello"], category: "greetings",
        kind: Phrase,
        ipa: "ɔˈla", pron_tags: [OpenClosedVowel],
        example: (pt: "Olá, tudo bem?", en: "Hi, how are you?"),
        note: "Informal and neutral. Works all day long.",
        needs_native_review: true,
    ),
    (
        id: "bom_dia", pt: "bom dia", en: ["good morning"], category: "greetings",
        kind: Phrase,
        ipa: "bõ ˈdiɐ", pron_tags: [NasalVowel, ReducedVowel],
        example: (pt: "Bom dia, dona Rosa!", en: "Good morning, Mrs Rosa!"),
        note: "Used until lunchtime.",
        needs_native_review: true,
    ),
    (
        id: "boa_tarde", pt: "boa tarde", en: ["good afternoon"], category: "greetings",
        kind: Phrase,
        ipa: "ˈboɐ ˈtaɾdɨ", pron_tags: [ReducedVowel, RhoticR],
        example: (pt: "Boa tarde, senhor Joaquim.", en: "Good afternoon, Mr Joaquim."),
        note: "From lunch until it gets dark.",
        needs_native_review: true,
    ),
    (
        id: "boa_noite", pt: "boa noite", en: ["good night", "good evening"], category: "greetings",
        kind: Phrase,
        ipa: "ˈboɐ ˈnojtɨ", pron_tags: [ReducedVowel],
        example: (pt: "Boa noite e bons sonhos!", en: "Good night and sweet dreams!"),
        note: "Both 'good evening' (greeting) and 'good night' (farewell).",
        needs_native_review: true,
    ),
    (
        id: "adeus", pt: "adeus", en: ["goodbye"], category: "greetings",
        kind: Phrase,
        ipa: "ɐˈdewʃ", pron_tags: [SibilantS],
        example: (pt: "Adeus, até amanhã!", en: "Goodbye, see you tomorrow!"),
        needs_native_review: true,
    ),
    (
        id: "ate_logo", pt: "até logo", en: ["see you later"], category: "greetings",
        kind: Phrase,
        ipa: "ɐˈtɛ ˈlogu", pron_tags: [OpenClosedVowel],
        example: (pt: "Até logo, avó!", en: "See you later, grandma!"),
        needs_native_review: true,
    ),
    (
        id: "por_favor", pt: "por favor", en: ["please"], category: "greetings",
        kind: Phrase,
        ipa: "puɾ fɐˈvoɾ", pron_tags: [ReducedVowel, RhoticR],
        example: (pt: "Um café, por favor.", en: "A coffee, please."),
        note: "'Se faz favor' is the slightly more polite everyday form in cafés.",
        forms: ["se faz favor"],
        needs_native_review: true,
    ),
    (
        id: "obrigado", pt: "obrigado", en: ["thank you"], category: "greetings",
        kind: Phrase,
        ipa: "obɾiˈgadu", pron_tags: [ReducedVowel],
        example: (pt: "Muito obrigado pela ajuda.", en: "Thank you very much for the help."),
        note: "Men say 'obrigado', women say 'obrigada'. It agrees with the speaker, not with the listener.",
        forms: ["obrigada"],
        needs_native_review: true,
    ),
    (
        id: "de_nada", pt: "de nada", en: ["you're welcome"], category: "greetings",
        kind: Phrase,
        ipa: "dɨ ˈnadɐ", pron_tags: [ReducedVowel],
        example: (pt: "De nada, foi um prazer.", en: "You're welcome, it was a pleasure."),
        needs_native_review: true,
    ),
    (
        id: "desculpe", pt: "desculpe", en: ["excuse me", "sorry"], category: "greetings",
        kind: Phrase,
        ipa: "dɨʃˈkulpɨ", pron_tags: [ReducedVowel, SibilantS],
        example: (pt: "Desculpe, pode ajudar-me?", en: "Excuse me, can you help me?"),
        note: "Formal form (o senhor / a senhora). With friends: 'desculpa'.",
        forms: ["desculpa"],
        needs_native_review: true,
    ),
    (
        id: "com_licenca", pt: "com licença", en: ["excuse me (to pass)"], category: "greetings",
        kind: Phrase,
        ipa: "kõ liˈsẽsɐ", pron_tags: [NasalVowel, SoftC],
        example: (pt: "Com licença, posso passar?", en: "Excuse me, may I pass?"),
        note: "Said when squeezing past someone or entering a room.",
        needs_native_review: true,
    ),
    (
        id: "tudo_bem", pt: "tudo bem", en: ["all good", "how are you"], category: "greetings",
        kind: Phrase,
        ipa: "ˈtudu ˈbɐ̃j", pron_tags: [NasalVowel, NasalDiphthong],
        example: (pt: "Olá, tudo bem?", en: "Hi, how's it going?"),
        note: "Informal. The answer is usually 'tudo bem' or 'tudo, e contigo?'.",
        needs_native_review: true,
    ),
    (
        id: "como_esta", pt: "como está", en: ["how are you (formal)"], category: "greetings",
        kind: Phrase, level: 2,
        ipa: "ˈkomu ɨʃˈta", pron_tags: [ReducedVowel, SibilantS],
        example: (pt: "Como está a sua família?", en: "How is your family?"),
        note: "Formal register. With friends use 'como estás?'.",
        forms: ["como estás"],
        needs_native_review: true,
    ),
    (
        id: "sim", pt: "sim", en: ["yes"], category: "greetings",
        kind: Phrase,
        ipa: "sĩ", pron_tags: [NasalVowel],
        example: (pt: "Sim, quero um pastel.", en: "Yes, I want a pastry."),
        needs_native_review: true,
    ),
    (
        id: "nao", pt: "não", en: ["no", "not"], category: "greetings",
        kind: Phrase,
        ipa: "nɐ̃w", pron_tags: [NasalDiphthong],
        example: (pt: "Não, obrigado.", en: "No, thank you."),
        needs_native_review: true,
    ),
    (
        id: "muito_prazer", pt: "muito prazer", en: ["nice to meet you"], category: "greetings",
        kind: Phrase, level: 2,
        ipa: "ˈmũjtu pɾɐˈzeɾ", pron_tags: [NasalVowel, RhoticR],
        example: (pt: "Muito prazer em conhecer-te.", en: "Nice to meet you."),
        note: "The pronoun attaches to the verb: 'conhecer-te'.",
        needs_native_review: true,
    ),
]
