// Grammar concept: Prepositions and articles
(
    id: "contractions",
    title: "Prepositions and articles",
    summary: "Small prepositions merge with articles: em+o = no, de+a = da, a+o = ao, por+a = pela.",
    rules: [
        "em + o/a = no / na (Estou no mercado. Está na mesa.)",
        "de + o/a = do / da (o pastel da avó)",
        "a + o/a = ao / à (Vou ao mercado. Vou à praia.)",
        "por + o/a = pelo / pela (Passo pela praça.)",
        "No article, no contraction: Vivo em Lisboa.",
    ],
    examples: [
        (pt: "Vou ao mercado.", en: "I am going to the market."),
        (pt: "O livro está na mesa.", en: "The book is on the table."),
        (pt: "Passo pela praça.", en: "I walk through the square."),
    ],
    pt_pt_note: "Same system in Brazil. In Portugal the 'à' (a + a) is very common because people say 'vou à praia', 'vou à escola'.",
    exercises: [
        (
            id: "co_1", kind: FillBlank,
            prompt: "Vivo ___ Lisboa.",
            context: "I live in Lisbon.",
            options: ["em", "na", "no"],
            answer: ["em"],
            explanation: "Lisboa has no article, so no contraction: em Lisboa.",
        ),
        (
            id: "co_2", kind: FillBlank,
            prompt: "O livro está ___ mesa.",
            context: "The book is on the table.",
            options: ["na", "no", "em a"],
            answer: ["na"],
            explanation: "em + a = na.",
        ),
        (
            id: "co_3", kind: FillBlank,
            prompt: "Vou ___ mercado.",
            context: "I am going to the market.",
            options: ["ao", "a o", "no"],
            answer: ["ao"],
            explanation: "a + o = ao.",
        ),
        (
            id: "co_4", kind: FillBlank,
            prompt: "O pastel ___ avó é bom.",
            context: "Grandma's pastry is good.",
            options: ["da", "de a", "do"],
            answer: ["da"],
            explanation: "de + a = da.",
        ),
        (
            id: "co_5", kind: FillBlank,
            prompt: "Passo ___ praça todos os dias.",
            context: "I walk through the square every day.",
            options: ["pela", "na", "da"],
            answer: ["pela"],
            explanation: "por + a = pela.",
        ),
        (
            id: "co_6", kind: Choice,
            prompt: "Which is correct?", prompt_lang: En,
            options: ["Vou à praia.", "Vou a praia."],
            answer: ["Vou à praia."],
            explanation: "a + a = à (with a grave accent).",
        ),
    ],
    needs_native_review: true,
)
