// Grammar concept: location phrases (ao pé de, à esquerda de, ...)
(
    id: "directions_prep",
    title: "Where is it? ao pé de, à esquerda, atrás de",
    summary: "Place phrases end in 'de' and merge with the article (do, da). 'À esquerda' and 'à direita' take a grave accent.",
    rules: [
        "Location phrases: ao pé de, perto de, longe de, ao lado de, atrás de, em frente de, à esquerda de, à direita de.",
        "'de' merges with the article that follows: de + o = do, de + a = da. So: ao pé do rio, perto da ponte, atrás do hotel.",
        "'à esquerda' and 'à direita' are a + a. The accent is part of the spelling: à esquerda.",
        "'Entre' (between) does not merge with articles: entre a ponte e o cais.",
        "To say where a place is, use 'ficar': O museu fica ao pé da ponte. Onde fica a farmácia?",
    ],
    examples: [
        (pt: "O museu fica ao pé da ponte.", en: "The museum is next to the bridge."),
        (pt: "O banco fica à esquerda do hotel.", en: "The bank is on the left of the hotel."),
        (pt: "O jardim fica atrás da igreja.", en: "The garden is behind the church."),
    ],
    pt_pt_note: "'Ao pé de' is a very natural, everyday way to say 'next to / near' in Portugal; 'perto de' works everywhere. Note 'à' (a + a) in 'à esquerda', and ask 'Onde fica...?' rather than 'Onde está...?' for places.",
    exercises: [
        (
            id: "dp_1", kind: FillBlank,
            prompt: "O museu fica ao pé ___ rio.",
            context: "The museum is next to the river.",
            options: ["do", "da", "de o"],
            answer: ["do"],
            explanation: "de + o = do. 'Rio' is masculine: ao pé do rio.",
        ),
        (
            id: "dp_2", kind: FillBlank,
            prompt: "A farmácia é perto ___ ponte.",
            context: "The pharmacy is near the bridge.",
            options: ["da", "do", "de a"],
            answer: ["da"],
            explanation: "de + a = da. 'Ponte' is feminine: perto da ponte.",
        ),
        (
            id: "dp_3", kind: FillBlank,
            prompt: "O banco fica ___ esquerda do hotel.",
            context: "The bank is on the left of the hotel.",
            options: ["à", "a", "na"],
            answer: ["à"],
            explanation: "a + a esquerda = à esquerda, written with a grave accent.",
        ),
        (
            id: "dp_4", kind: Choice,
            prompt: "How do you say \"The garden is behind the church\"?",
            prompt_lang: En,
            options: ["O jardim fica atrás da igreja.", "O jardim fica atrás a igreja.", "O jardim fica atrás de a igreja."],
            answer: ["O jardim fica atrás da igreja."],
            explanation: "atrás de + a = atrás da. We never write 'de a'.",
        ),
        (
            id: "dp_5", kind: FillBlank,
            prompt: "A ponte fica ___ dois bairros.",
            context: "The bridge is between two neighbourhoods.",
            options: ["entre", "ao pé", "atrás"],
            answer: ["entre"],
            explanation: "'Entre' means between. Only entre fits before 'dois bairros'.",
        ),
        (
            id: "dp_6", kind: Order,
            prompt: "The hotel is beside the bank.",
            prompt_lang: En,
            answer: ["O hotel fica ao lado do banco."],
            explanation: "ao lado de + o banco = ao lado do banco.",
        ),
        (
            id: "dp_7", kind: Type,
            prompt: "Onde ___ a estação? (ficar)",
            context: "Where is the station?",
            answer: ["fica"],
            hint: "ficar, 3rd person singular",
            explanation: "For the location of a place we use 'ficar': Onde fica a estação?",
        ),
        (
            id: "dp_8", kind: Choice,
            prompt: "Which one means \"far from the river\"?",
            prompt_lang: En,
            options: ["longe do rio", "perto do rio", "entre o rio"],
            answer: ["longe do rio"],
            explanation: "longe de = far from. perto de is the opposite (near).",
        ),
        (
            id: "dp_9", kind: Order,
            prompt: "Where is the pharmacy?",
            prompt_lang: En,
            answer: ["Onde fica a farmácia?"],
            explanation: "Onde fica + the place: the everyday way to ask where something is.",
        ),
    ],
    needs_native_review: true,
)
