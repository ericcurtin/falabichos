// Grammar concept: commands for giving directions (tu and polite)
(
    id: "imperative_directions",
    title: "Giving directions: tu and polite commands",
    summary: "To a friend (tu) use vira, segue, atravessa. To a stranger use vire, siga, atravesse.",
    rules: [
        "Tu command (affirmative): the 'ele/ela' form of the present tense: vira (virar), segue (seguir), atravessa (atravessar), sobe (subir), desce (descer).",
        "Polite command (o senhor / a senhora): -ar verbs end in -e (vire, atravesse), -er and -ir verbs end in -a (suba, desça); seguir is irregular: siga.",
        "Negative tu command: não + the tu form of the subjunctive: Não vires à direita. (Not 'não vira'.)",
        "Politeness: add 'por favor' or 'se faz favor' and start strangers' questions with 'Desculpe,'.",
        "Pronouns follow an affirmative command with a hyphen: Segue-me! (Follow me!)",
    ],
    examples: [
        (pt: "Vira à esquerda e segue em frente.", en: "Turn left and keep going straight."),
        (pt: "Vire à direita, por favor.", en: "Turn right, please."),
        (pt: "Desculpe, onde fica a farmácia?", en: "Excuse me, where is the pharmacy?"),
    ],
    pt_pt_note: "Use 'tu' commands with friends and children, and the polite commands with strangers and elders (never 'você' to be polite in Portugal). A native speaker should double-check the register notes.",
    exercises: [
        (
            id: "im_1", kind: FillBlank,
            prompt: "___ à esquerda na ponte.",
            context: "Turn left at the bridge. (to a friend, tu)",
            options: ["Vira", "Vire", "Viras"],
            answer: ["Vira"],
            explanation: "The tu command of virar is vira. 'Vire' is the polite form.",
        ),
        (
            id: "im_2", kind: FillBlank,
            prompt: "___ em frente até ao cais, se faz favor.",
            context: "Keep going straight to the quay, please. (to an older stranger)",
            options: ["Siga", "Segue", "Seguir"],
            answer: ["Siga"],
            explanation: "To a stranger we use the polite command: siga (from seguir).",
        ),
        (
            id: "im_3", kind: Choice,
            prompt: "Which one is a command to a friend (tu)?",
            prompt_lang: En,
            options: ["Atravessa a ponte.", "Atravesse a ponte.", "Atravessar a ponte."],
            answer: ["Atravessa a ponte."],
            explanation: "tu command = ele/ela form: atravessa. 'Atravesse' is polite and 'atravessar' is the infinitive.",
        ),
        (
            id: "im_4", kind: Type,
            prompt: "___ a rua até à torre. (subir, tu)",
            context: "Go up the street to the tower.",
            answer: ["Sobe"],
            hint: "subir: u becomes o",
            explanation: "In subir the u becomes o in the tu and ele forms (eu subo, tu sobes, ele sobe), so the tu command is sobe.",
        ),
        (
            id: "im_5", kind: FillBlank,
            prompt: "Não ___ à direita!",
            context: "Don't turn right! (tu)",
            options: ["vires", "vira", "vire"],
            answer: ["vires"],
            explanation: "A negative tu command uses the -es form: não vires.",
        ),
        (
            id: "im_6", kind: Order,
            prompt: "Turn right at the corner. (tu)",
            prompt_lang: En,
            answer: ["Vira à direita na esquina."],
            explanation: "vira (tu command) + à direita + na esquina.",
        ),
        (
            id: "im_7", kind: Choice,
            prompt: "How do you politely tell a stranger to turn right?",
            prompt_lang: En,
            options: ["Vire à direita.", "Vira à direita.", "Viras à direita."],
            answer: ["Vire à direita."],
            explanation: "The polite command of virar is vire.",
        ),
        (
            id: "im_8", kind: Order,
            prompt: "Excuse me, where is the pharmacy?",
            prompt_lang: En,
            answer: ["Desculpe, onde fica a farmácia?"],
            explanation: "'Desculpe' opens a polite question to a stranger.",
        ),
        (
            id: "im_9", kind: Translate,
            prompt: "Cross the bridge, please. (tu)",
            prompt_lang: En,
            answer: ["Atravessa a ponte, por favor."],
            word_hints: [("cross", "atravessa"), ("bridge", "ponte"), ("please", "por favor")],
            explanation: "tu command = ele/ela form of the present: atravessa. Then 'a ponte' and 'por favor'.",
        ),
    ],
    needs_native_review: true,
)
