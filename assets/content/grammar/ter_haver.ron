// Grammar concept: ter and haver (to have / there is)
(
    id: "ter_haver",
    title: "Ter and há",
    summary: "'Ter' means to have (tenho, tens, tem...). 'Há' means 'there is / there are' and never changes.",
    rules: [
        "ter (to have): eu tenho, tu tens, ele/ela tem, nós temos, eles/elas têm. Note têm (plural, with a circumflex) vs tem (singular).",
        "há = there is / there are. It is invariable: Há um museu. Há dois museus. (Never 'hão'.)",
        "Ter is also used for feelings and age: Tenho fome. Tenho frio. Tenho vinte anos.",
        "ter de + infinitive = to have to: Tenho de ir ao banco.",
        "Asking for something in a shop uses ter (Tem pão?). Asking whether something exists uses há (Há uma farmácia aqui perto?).",
    ],
    examples: [
        (pt: "Eu tenho um mapa da cidade.", en: "I have a map of the city."),
        (pt: "Há uma ponte sobre o rio.", en: "There is a bridge over the river."),
        (pt: "Eles têm fome.", en: "They are hungry."),
    ],
    pt_pt_note: "In Brazil, 'tem' is very often used for 'there is' (Tem um banco aqui). In Portugal the standard way is 'há'. Learn 'há' first.",
    exercises: [
        (
            id: "th_1", kind: FillBlank,
            prompt: "Eu ___ fome.",
            context: "I am hungry.",
            options: ["tenho", "tens", "tem"],
            answer: ["tenho"],
            explanation: "Eu goes with tenho. Portuguese says 'I have hunger': tenho fome.",
        ),
        (
            id: "th_2", kind: FillBlank,
            prompt: "Tu ___ um mapa?",
            context: "Do you have a map?",
            options: ["tens", "tem", "tenho"],
            answer: ["tens"],
            explanation: "Tu goes with tens.",
        ),
        (
            id: "th_3", kind: FillBlank,
            prompt: "Eles ___ dois barcos.",
            context: "They have two boats.",
            options: ["têm", "tem", "temos"],
            answer: ["têm"],
            explanation: "The plural (eles, elas) is têm with a circumflex. The singular ele tem has no accent.",
        ),
        (
            id: "th_4", kind: Choice,
            prompt: "How do you say \"There is a bank near the river\"?",
            prompt_lang: En,
            options: ["Há um banco perto do rio.", "Tem um banco perto do rio.", "Hão um banco perto do rio."],
            answer: ["Há um banco perto do rio."],
            explanation: "'Há' is the standard pt-PT way to say 'there is'. 'Tem' for 'there is' sounds Brazilian, and 'hão' does not exist in this meaning.",
        ),
        (
            id: "th_5", kind: FillBlank,
            prompt: "___ muitas pessoas na ponte.",
            context: "There are many people on the bridge.",
            options: ["Há", "Têm", "Tem"],
            answer: ["Há"],
            explanation: "'Há' does not change for the plural: há um museu, há muitos museus.",
        ),
        (
            id: "th_6", kind: Type,
            prompt: "Nós ___ um mapa. (ter)",
            context: "We have a map.",
            answer: ["temos"],
            explanation: "Nós temos. The pattern: tenho, tens, tem, temos, têm.",
        ),
        (
            id: "th_7", kind: Order,
            prompt: "Is there a pharmacy near here?",
            prompt_lang: En,
            answer: ["Há uma farmácia perto daqui?"],
            explanation: "Há + uma farmácia + perto daqui: no verb change needed, even for 'there are'.",
        ),
        (
            id: "th_8", kind: FillBlank,
            prompt: "Eu ___ de ir ao banco.",
            context: "I have to go to the bank.",
            options: ["tenho", "há", "tem"],
            answer: ["tenho"],
            explanation: "ter de + infinitive means 'to have to'. The subject is eu, so tenho.",
        ),
        (
            id: "th_9", kind: Choice,
            prompt: "How do you say \"I am cold\"?",
            prompt_lang: En,
            options: ["Tenho frio.", "Sou frio.", "Há frio."],
            answer: ["Tenho frio."],
            explanation: "Feelings like cold, hunger and thirst use ter: tenho frio, tenho fome, tenho sede. ('Sou frio' would mean you are a cold person.)",
        ),
        (
            id: "th_10", kind: Translate,
            prompt: "I have a map of the city.",
            prompt_lang: En,
            answer: ["Tenho um mapa da cidade.", "Eu tenho um mapa da cidade."],
            word_hints: [("have", "tenho"), ("map", "mapa"), ("city", "cidade")],
            explanation: "Tenho um mapa da cidade. The subject 'eu' can be left out: the verb ending already says who.",
        ),
    ],
    needs_native_review: true,
)
